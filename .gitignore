# Private working notes — raw incident forensics live here pre-sanitization.
# This MUST stay ignored: publishing this repo must never leak them.
notes/

__pycache__/
*.egg-info/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/
.pytest-tmp/

# Channel doorbell + writer lock are runtime state, not record.
# Legacy layout and the 0.4 named layout (<id>.signal.json / <id>.lock) alike.
collab/signal.json
collab/.lock
collab/*.signal.json
collab/*.lock

# Host-specific live config stays local; sanitized examples are committed instead.
watcher.json
.claude/settings.local.json

# Review worktrees live inside the repo. Each is a full checkout, so an
# absent-minded `git add -A` would try to commit whole trees into this one.
.claude/worktrees/

# Session handovers are internal working notes: host paths, credential logistics,
# unreleased work. Session 2 reached the public repo by omission, not by choice.
docs/HANDOVER-SESSION-*.md

# Planning documents are how this project is BUILT, not what it ships. They carry
# host paths, unreleased research, business strategy and in-flight design argument
# — development intricacies with no reason to be public. The shipped artifacts are
# README.md, PROTOCOL.md, examples/ and docs/case-study.md.
docs/plans/

# The retired channel: 187 messages mixing this project with debate-bench research,
# unpublished benchmark results and host paths. Kept as local history, never published.
# It is append-only by design and so could not be cleaned in place.
collab-retired-*/
